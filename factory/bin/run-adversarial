#!/usr/bin/env bash
# Runs the Codex plugin's adversarial review on a job branch and writes it as a
# factory review file.
#
#   factory/bin/run-adversarial <job-folder> <worktree> <round>
#
# Writes <job-folder>/round-<round>/review-adversarial.md. The review is
# read-only. Findings at a severity in "block_on" with confidence of at least
# "min_confidence" (factory/models.json, key reviewer-adversarial) make the
# verdict CHANGES; everything else goes under Notes. The raw JSON is kept in
# <job-folder>/.runs/. Set CODEX_COMPANION to use a specific codex-companion.mjs.
set -uo pipefail

if [ $# -ne 3 ]; then
  echo "usage: run-adversarial <job-folder> <worktree> <round>" >&2
  exit 2
fi
job=$1 worktree=$2 round=$3
factory=$(cd "$(dirname "$0")/.." && pwd)
entry=$(jq -e '.["reviewer-adversarial"]' "$factory/models.json") || {
  echo "run-adversarial: no reviewer-adversarial in models.json" >&2; exit 2; }
model=$(jq -r '.model // empty' <<<"$entry")
block_on=$(jq -c '.block_on // ["critical", "high"]' <<<"$entry")
min_conf=$(jq -r '.min_confidence // 0.6' <<<"$entry")

companion=${CODEX_COMPANION:-$(ls -d ~/.claude/plugins/cache/openai-codex/codex/*/scripts/codex-companion.mjs 2>/dev/null | sort -V | tail -n 1)}
[ -f "$companion" ] || { echo "run-adversarial: Codex plugin not found; install it or set CODEX_COMPANION" >&2; exit 2; }
[ -f "$job/spec.md" ] || { echo "run-adversarial: missing $job/spec.md" >&2; exit 2; }

mkdir -p "$job/.runs" "$job/round-$round"
log="$job/.runs/$(date +%Y%m%d-%H%M%S)-reviewer-adversarial"
focus="Challenge this branch against its spec below. Look for ways it breaks: unmet or weakly verified acceptance criteria, edge cases, regressions, and anything the spec's Out of scope forbids.

$(cat "$job/spec.md")"

rc=0
node "$companion" adversarial-review --json --base main --scope branch \
  --cwd "$worktree" ${model:+--model "$model"} "$focus" >"$log.json" 2>"$log.stderr" || rc=$?

if ! jq -e '.result.verdict' "$log.json" >/dev/null 2>&1; then
  echo "run-adversarial: no structured review (exit $rc). See $log.json and $log.stderr" >&2
  exit 1
fi

out="$job/round-$round/review-adversarial.md"
jq -r --argjson block "$block_on" --argjson min "$min_conf" '
  .result as $r
  | [$r.findings[] | select((.severity as $s | $block | index($s)) and .confidence >= $min)] as $blocking
  | [$r.findings[] | select(((.severity as $s | $block | index($s)) and .confidence >= $min) | not)] as $notes
  | def item: "\(.file):\(.line_start) [\(.severity), confidence \(.confidence)] \(.title). \(.body) Fix: \(.recommendation)";
  "VERDICT: \(if ($blocking | length) > 0 then "CHANGES" else "PASS" end)\n",
  "## Summary\nCodex adversarial review: \($r.verdict). \($r.summary)\n",
  "## Findings",
  (if ($blocking | length) == 0 then "None." else ($blocking | to_entries[] | "\(.key + 1). \(.value | item)") end),
  "\n## Notes",
  (if ($notes | length) == 0 then "None." else ($notes[] | "- \(item)") end),
  (if ($r.next_steps | length) > 0 then "\nSuggested next steps:", ($r.next_steps[] | "- \(.)") else empty end)
' "$log.json" >"$out" || { echo "run-adversarial: could not write $out" >&2; exit 1; }

echo "reviewer-adversarial: ${model:-default model}. $(head -n 1 "$out"). Wrote $out"
