#!/usr/bin/env bash
# Asks Jev (factory/bin/jev) for the factory's routing decisions.
#
#   factory/bin/jev-decide route <job-folder> <task-id>
#   factory/bin/jev-decide triage <job-folder> <round>
#   factory/bin/jev-decide reviewers <job-folder> <round>
#
# Subcommands are dispatched by name from main. They share three helpers:
# cfg (the jev settings over their defaults), ask (one call to jev) and
# log_line (one line appended to <job-folder>/jev.jsonl).
#
# route: picks the model tier for a task's first build run. Prints one line,
# "<role-key> (<why>)", where <why> is "jev <option> p=<p>", "fallback
# low-confidence|cap|error" or "off". The orchestrator takes the first word.
# With send off, or route false, it prints "builder (off)" and logs nothing.
# Tiers: light -> builder-light, standard -> builder-standard, thorough ->
# builder, strong -> builder-escalation. A tier key missing from models.json
# runs as builder. The answer is used only when its p >= min_confidence, and
# strong only while the newest Codex rollout's rate_limits.primary.used_percent
# under ${CODEX_SESSIONS_DIR:-~/.codex/sessions} is below sol_ceiling x 100
# (no rollout means allowed; skipped unless builder-escalation is openai).
# The state sent is facts about the task: label, round, files named with line
# counts, a history line for their top-level directories and, in summary mode
# only, the title and description. Never code, diffs or logs. jev redacts it.
#
# triage: sorts the Notes of an all-PASS round. Reads every
# round-<N>/review-<lens>.md (security, code, ux, ui, adversarial) and writes
# round-<N>/triage.json ({fix_now, follow_up, fine, approver}, items {n, lens,
# path, title, text, p, why}) and triage.md, then prints "triage round <N>: <a>
# fix-now, <b> follow-up, <c> fine, <d> for the approver" ("off" with send off
# or triage false, writing nothing). Security Notes and Notes on a path matching
# jev/park-paths.txt or jev.park_paths are never sent: approver, why guardrail.
# The rest go to Jev as note.1 .. note.<k> (jev/triage.json holds the question
# templates; round-<N>/triage.json is the result). An answer under min_confidence
# is approver/low-confidence; a failed call, a missing answer or a choice the
# question did not offer is approver/error; metadata mode offers only fine or
# approver, and approver is why "jev".
#
# reviewers: decides which review lenses a round can skip. Asks review.ux and
# review.ui always, review.security and review.code only when the run index
# r = round - round_base is 2 or more (adversarial is never asked), with a state
# of the changed files (git diff --numstat against `settings base`, 40 listed),
# the UI files and, for security/code, the previous round's verdict, counts and
# fix-task files. A skip answered with p >= min_confidence writes
# round-<N>/review-<lens>.md ("VERDICT: SKIPPED", blank, "Skipped by Jev (p=<p>):
# <state line>."); a lens whose file already exists is not asked. Prints
# "reviewers round <N>: run <lenses>; skip <lens> (p=<p>), ..." or "run all"
# (nothing skipped, off, or any jev failure). Outcome did is "skip" or "run".
#
# jev is ${JEV_BIN:-<factory>/bin/jev}. A jev failure prints its stderr line
# once and falls back to builder. Every subcommand always exits 0.
#
# jev.jsonl lines: {ts, decision, task, round, send, state, answers, latency_ms,
# input_tokens, outcome: {<key>: {used, why, did}}}; state is the redacted state
# jev sent, or null when nothing was sent; why is null, low-confidence, cap,
# guardrail or error.
set -uo pipefail

factory=$(cd "$(dirname "$0")/.." && pwd)
jev_bin=${JEV_BIN:-$factory/bin/jev}

now_iso() { date +%Y-%m-%dT%H:%M:%S%z | sed -E 's/([0-9]{2})$/:\1/'; }

# cfg: the jev settings merged over their defaults, as compact JSON.
cfg() {
  local defaults='{"send":"off","route":true,"triage":true,"reviewers":true,"min_confidence":0.7,"sol_ceiling":0.8,"park_paths":[],"model":"jev-latest"}' got
  got=$("$factory/bin/settings" jev 2>/dev/null) || got=
  jq -cn --argjson d "$defaults" --arg c "${got:-{\}}" '$d + (($c | fromjson? // {}) | if type == "object" then . else {} end)'
}

# ask <decision> <questions-file> <state-file>: prints jev's JSON; fails when
# jev does (its stderr line passes through). <decision> is for callers' logs.
# shellcheck disable=SC2329 # used by the subcommands
ask() {
  "$jev_bin" "$2" "$3"
}

# try_ask <decision> <questions-file> <state-file>: ask, and fail too when what
# came back is not JSON. Prints jev's JSON.
try_ask() {
  local out
  out=$(ask "$@") && jq -e . >/dev/null 2>&1 <<<"$out" || return 1
  printf '%s\n' "$out"
}

# log_line <job-folder> <json>: appends the object as one compact line.
log_line() {
  jq -c . <<<"$2" >>"$1/jev.jsonl" 2>/dev/null || echo "jev-decide: could not write $1/jev.jsonl" >&2
}

# log_error <job-folder> <decision> <task> <round> <send> <outcome-json>: the
# line for a call that failed (jev down, no key, bad reply): no state, no answers.
log_error() {
  log_line "$1" "$(make_line "$2" "$3" "$4" "$5" "" "$6")"
}

# make_line <decision> <task> <round> <send> <jev-json|""> <outcome-json>
make_line() {
  jq -n -c --arg ts "$(now_iso)" --arg decision "$1" --arg task "$2" --argjson round "${3:-null}" \
    --arg send "$4" --arg j "$5" --argjson outcome "$6" '
    ($j | fromjson? // {}) as $r
    | { ts: $ts, decision: $decision, task: $task, round: $round, send: $send,
        state: ($r.state // null),
        answers: ($r.answers // {} | map_values({choice, p})),
        latency_ms: ($r.latency_ms // null), input_tokens: ($r.input_tokens // null),
        outcome: $outcome }'
}

# paths_in: reads text on stdin, prints the file paths it names, one per line
# (emails and URLs dropped, ":line" suffixes and trailing punctuation cut).
paths_in() {
  sed -E 's#[A-Za-z][A-Za-z0-9+.-]*://[^[:space:]]+# #g; s#[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+# #g' |
    grep -oE '[A-Za-z0-9_./-]+\.(sh|bash|md|json|jsonl|js|mjs|ts|tsx|jsx|py|go|rs|rb|java|c|h|cpp|yml|yaml|toml|html|css|txt|sql|tf)\b(:[0-9]+)?' |
    sed -E 's/:[0-9]+$//; s#^\./##' | awk '!seen[$0]++' | head -n 20
}

# task_files <job> <task-id> <title>: the files the task names, one per line.
task_files() {
  local job=$1 title=$3 n lens
  case $title in
    "Fix round "*" notes")
      n=${title#Fix round }; n=${n%% *}
      jq -r '.fix_now[]?.path // empty' "$job/round-$n/triage.json" 2>/dev/null | awk '!seen[$0]++'
      ;;
    "Fix round "*" review")
      n=${title#Fix round }; n=${n%% *}
      lens=${title#"Fix round $n "}; lens=${lens% review}
      sed -n '/^## Findings/,/^## /p' "$job/round-$n/review-$lens.md" 2>/dev/null | sed '1d;/^## /d' | paths_in
      ;;
    *)
      jq -r --arg t "$title" '[.tasks[]? | select(.title == $t) | .description // ""] | first // ""' "$job/plan.json" 2>/dev/null | paths_in
      ;;
  esac
}

# top_dir <path>: its top-level directory, or "." for a root file.
top_dir() { case $1 in */*) echo "${1%%/*}/" ;; *) echo "." ;; esac; }

# commit_files <build-report>: the paths in its "## Commit" -> "Files:" bullets.
commit_files() {
  awk '/^## /{c = ($0 == "## Commit"); fl = 0; next} c && /^Files:/{fl = 1; next} c && fl && /^- /{sub(/^- /, ""); print; next} fl && !/^- /{fl = 0}' "$1"
}

# history_line "<dirs>": how earlier tasks touching these space-separated
# top-level directories went, from every factory/jobs/*/job.json and build/<id>.md.
# SELF_TASK (<job>/<id>) is left out. Prints nothing without directories.
history_line() {
  local dirs=$1 jf jd id role flag f d hit rows=""
  [ -n "$dirs" ] || return 0
  for jf in "$factory"/jobs/*/job.json; do
    [ -f "$jf" ] || continue
    jd=$(dirname "$jf")
    while IFS=$'\t' read -r id role flag; do
      [ -n "$id" ] || continue
      [ "$jd/$id" = "$SELF_TASK" ] && continue
      f=$jd/build/$id.md
      [ -f "$f" ] || continue
      hit=0
      while IFS= read -r p; do
        d=$(top_dir "$p")
        case " $dirs " in *" $d "*) hit=1; break ;; esac
      done < <(commit_files "$f")
      [ "$hit" = 1 ] && rows="$rows$role	$flag
"
    done < <(jq -r '.tasks[]? | [.id, (.role // "builder"), (if (.runs // 1) > 1 or .status == "blocked" then 1 else 0 end)] | @tsv' "$jf" 2>/dev/null)
  done
  if [ -z "$rows" ]; then
    echo "History: no earlier tasks touched ${dirs// /, }."
    return 0
  fi
  printf '%s' "$rows" | awk -F'\t' -v dirs="${dirs// /, }" '
    { n++; ran[$1]++; blk[$1] += $2; if (!($1 in seen)) { seen[$1] = 1; order[++k] = $1 } }
    END { out = "History: " n " earlier task" (n == 1 ? "" : "s") " touched " dirs ".";
      for (i = 1; i <= k; i++) out = out " " order[i] ": " ran[order[i]] " ran, " blk[order[i]] " went BLOCKED.";
      print out }'
}

# route_state <job> <task-id> <send>: the state text for one task.
route_state() {
  local job=$1 id=$2 send=$3 wt round title label desc files="" f n dirs="" d
  wt=$(jq -r '.worktree // empty' "$job/job.json")
  round=$(jq -r '.round // 0' "$job/job.json")
  title=$(jq -r --arg id "$id" '[.tasks[]? | select(.id == $id) | .title // ""] | first // ""' "$job/job.json")
  label=$(jq -r --arg id "$id" '[.tasks[]? | select(.id == $id) | if .final == true then "final" elif .fix == true or (.fix | type) == "string" then "fix" else "none" end] | first // "none"' "$job/job.json")
  while IFS= read -r f; do
    [ -n "$f" ] || continue
    if [ -f "$wt/$f" ]; then n="$(wc -l <"$wt/$f" | tr -d ' ') lines"; else n=new; fi
    files="$files${files:+, }$f ($n)"
    d=$(top_dir "$f")
    case " $dirs " in *" $d "*) ;; *) dirs="$dirs${dirs:+ }$d" ;; esac
  done < <(task_files "$job" "$id" "$title")
  [ "$send" = summary ] && printf 'Task: %s\n' "$title"
  printf 'Label: %s\nRound: %s\nFiles: %s\n' "$label" "$round" "${files:-none named}"
  if [ "$send" = summary ]; then
    desc=$(jq -r --arg t "$title" '[.tasks[]? | select(.title == $t) | .description // ""] | first // ""' "$job/plan.json" 2>/dev/null)
    [ -n "$desc" ] && printf 'Description: %s\n' "$desc"
  fi
  SELF_TASK=$job/$id history_line "$dirs"
}

# cap_hit <sol-ceiling>: true when the newest Codex rollout's last
# rate_limits.primary.used_percent is at or over ceiling x 100.
cap_hit() {
  local root=${CODEX_SESSIONS_DIR:-$HOME/.codex/sessions} f newest="" used
  [ "$(jq -r '.["builder-escalation"].provider // ""' "$factory/models.json" 2>/dev/null)" = openai ] || return 1
  while IFS= read -r f; do
    [ -n "$f" ] || continue
    if [ -z "$newest" ] || [ "$f" -nt "$newest" ]; then newest=$f; fi
  done < <(find "$root" -name 'rollout-*.jsonl' 2>/dev/null)
  [ -n "$newest" ] || return 1
  used=$(grep token_count "$newest" | jq -R -r 'try (fromjson | .payload.rate_limits.primary.used_percent // empty) catch empty' | tail -n 1)
  [ -n "$used" ] || return 1
  awk -v u="$used" -v c="$1" 'BEGIN { exit !(u >= c * 100) }'
}

cmd_route() {
  local job=$1 id=$2 conf send min ceil tmp out round
  conf=$(cfg)
  send=$(jq -r '.send' <<<"$conf")
  if [ "$(jq -r '.route' <<<"$conf")" = false ]; then send=off; fi
  case $send in metadata | summary) ;; *) echo "builder (off)"; return ;; esac
  min=$(jq -r '.min_confidence' <<<"$conf")
  ceil=$(jq -r '.sol_ceiling' <<<"$conf")
  round=$(jq -c '.round // null' "$job/job.json" 2>/dev/null) || round=null
  [ -n "$round" ] || round=null

  tmp=$(mktemp -d "${TMPDIR:-/tmp}/jev-decide.XXXXXX") || { echo "builder (fallback error)"; return; }
  route_state "$job" "$id" "$send" >"$tmp/state" 2>/dev/null
  if ! out=$(try_ask route "$factory/jev/route.json" "$tmp/state"); then
    log_error "$job" route "$id" "$round" "$send" \
      '{"route":{"used":false,"why":"error","did":"ran as builder"}}'
    rm -rf "$tmp"
    echo "builder (fallback error)"
    return
  fi
  rm -rf "$tmp"

  local choice p role=builder why=null did used=true line
  choice=$(jq -r '.answers.route.choice' <<<"$out")
  p=$(jq -r '.answers.route.p' <<<"$out")
  case $choice in
    light) role=builder-light ;;
    standard) role=builder-standard ;;
    strong) role=builder-escalation ;;
    *) role=builder ;;
  esac
  if awk -v p="$p" -v m="$min" 'BEGIN { exit !(p < m) }'; then
    used=false why='"low-confidence"' role=builder did="p=$p is below $min; ran as builder"
    line="builder (fallback low-confidence)"
  elif [ "$choice" = strong ] && cap_hit "$ceil"; then
    used=false why='"cap"' role=builder did="Codex weekly usage is at the ceiling; ran as builder"
    line="builder (fallback cap)"
  else
    did="ran as $role"
    if ! jq -e --arg r "$role" 'has($r)' "$factory/models.json" >/dev/null 2>&1; then
      did="$role is not in models.json; ran as builder"
      role=builder
    fi
    line="$role (jev $choice p=$p)"
  fi
  log_line "$job" "$(make_line route "$id" "$round" "$send" "$out" \
    "$(jq -cn --argjson u "$used" --argjson w "$why" --arg d "$did" '{route: {used: $u, why: $w, did: $d}}')")"
  echo "$line"
}

# notes_of <review-file>: the Notes in its "## Notes" section, one per line:
# bullets stripped, "None." and the "Suggested next steps:" tail dropped.
notes_of() {
  awk '/^## /{ n = ($0 ~ /^## Notes[ \t]*$/); next }
    n && /^Suggested next steps:/{ n = 0; next }
    n && NF { print }' "$1" 2>/dev/null |
    sed -E 's/^[[:space:]]*([-*]|[0-9]+\.)[[:space:]]+//; s/^[[:space:]]+//; s/[[:space:]]+$//' |
    grep -viE '^none\.?$' || true
}

# paths_of "<note>": every token of the note that looks like a path (a "/" in
# it, a ".<ext>" end, or a Dockerfile/Makefile-style name), one per line, first
# occurrence only. Markdown wrappers (` * _), trailing punctuation and
# line suffixes (:N, :N-M, :N:M, #LN, #LN-LM) are stripped.
paths_of() {
  printf '%s\n' "$1" | awk -v q="'" '{
    for (i = 1; i <= NF; i++) {
      t = $i
      if (t ~ /:\/\//) continue
      sub("^[(\"" q "`*_]+", "", t)
      for (k = 0; k < 3; k++) {
        sub("[],;)\"" q "`*_.]+$", "", t)
        sub(/:[0-9]+(-[0-9]+)?(:[0-9]+)?$/, "", t)
        sub(/#L[0-9]+(-L?[0-9]+)?$/, "", t)
      }
      gsub(/`/, "", t)
      if (t != "" && !(t in seen) && (t ~ /\// || t ~ /\.[A-Za-z][A-Za-z0-9]*$/ || t ~ /^(Dockerfile|Makefile|Gemfile|Rakefile|Procfile)[A-Za-z0-9._-]*$/)) { seen[t] = 1; print t }
    } }'
}

# path_of "<note>": the first of those, or nothing.
path_of() { paths_of "$1" | head -n 1; }

# parked <path> <glob>...: true when the path matches a glob, as it is or as
# ./path, ignoring case.
parked() {
  local p=$1 g r=1 old
  shift
  old=$(shopt -p nocasematch)
  shopt -s nocasematch
  for g in "$@"; do
    # shellcheck disable=SC2053 # the glob is meant as a pattern
    if [[ $p == $g || ./$p == $g ]]; then r=0; break; fi
  done
  eval "$old"
  return $r
}

# triage_state <items-json> <send>: the state text, one line per Note that is
# not guarded, numbered from 1 in the order of the questions.
triage_state() {
  jq -r --arg send "$2" '
    [ .[] | select(.guarded | not) ] | to_entries[]
    | "Note \(.key + 1): lens \(.value.lens)"
      + (if .value.severity then "; severity \(.value.severity)" else "" end)
      + (if .value.confidence then "; confidence \(.value.confidence)" else "" end)
      + "; path \(.value.path // "none"); raised before: \(if .value.seen then "yes" else "no" end)"
      + (if $send == "summary" then "; text: \(.value.text)" else "" end)' <<<"$1"
}

# triage_questions <send> <count>: note.1 .. note.<count> from jev/triage.json.
triage_questions() {
  local tpl='note'
  if [ "$1" = metadata ]; then tpl='note-metadata'; fi
  jq --arg t "$tpl" --argjson c "$2" '
    .[$t] as $q
    | [range(1; $c + 1) as $i | {key: "note.\($i)", value: ($q | .instructions.about = "Note \($i) in the state")}]
    | from_entries' "$factory/jev/triage.json"
}

# triage_sort <items-json> <answers-json|null> <send> <min>: prints
# {result: {fix_now, follow_up, fine, approver}, outcome: {<key>: {used, why, did}}}.
# A missing answer, or a choice the question did not offer, counts as an error.
triage_sort() {
  jq -c --argjson a "$2" --arg send "$3" --argjson min "$4" '
    (if $send == "metadata" then ["fine", "approver"] else ["fix-now", "follow-up", "fine"] end) as $ok
    | [ foreach .[] as $it (0; if $it.guarded then . else . + 1 end; [$it, .]) ]
    | map(. as [$it, $k]
        | ($a["note.\($k)"]) as $r
        | (if $it.guarded then {b: "approver", why: "guardrail", p: null}
           elif $r == null or ($r.choice as $c | $ok | any(. == $c) | not) then {b: "approver", why: "error", p: null}
           elif $r.p < $min then {b: "approver", why: "low-confidence", p: $r.p}
           elif $r.choice == "approver" then {b: "approver", why: "jev", p: $r.p}
           else {b: $r.choice, why: null, p: $r.p} end)
        + {it: $it, key: (if $it.guarded then "guarded.\($it.n)" else "note.\($k)" end)}) as $rows
    | def item: {n: .it.n, lens: .it.lens, path: .it.path, title: .it.title, text: .it.text, p: .p}
        + (if .b == "approver" then {why: .why} else {} end);
      { result: {
          fix_now: [$rows[] | select(.b == "fix-now") | item],
          follow_up: [$rows[] | select(.b == "follow-up") | item],
          fine: [$rows[] | select(.b == "fine") | item],
          approver: [$rows[] | select(.b == "approver") | item] },
        outcome: ($rows | map({key, value: {
          used: (.why == null or .why == "jev"),
          why: (if .why == "jev" then null else .why end),
          did: (if .why == "guardrail" then "guarded; left for the approver"
                elif .why == "error" then "no usable answer; left for the approver"
                elif .why == "low-confidence" then "p=\(.p) is below \($min); left for the approver"
                elif .why == "jev" then "Jev left it for the approver"
                else "triaged as \(.b)" end)}}) | from_entries) }' <<<"$1"
}

# triage_md <result-json>: the text of triage.md.
triage_md() {
  jq -r '
    def line: "- [\(.lens)] \(.text)" + (if .p != null then " (p=\(.p))" else "" end) + (if .why then " — \(.why)" else "" end);
    def sec($h; $a): "\n## \($h)\n" + (if ($a | length) == 0 then "None." else ($a | map(line) | join("\n")) end);
    "TRIAGE: \(.fix_now | length) fix-now, \(.follow_up | length) follow-up, \(.fine | length) fine, \(.approver | length) approver"
    + sec("Fix now"; .fix_now) + "\n" + sec("Follow-up"; .follow_up) + "\n" + sec("Fine"; .fine)
    + "\n" + sec("For the approver"; .approver)' <<<"$1"
}

cmd_triage() {
  local tok job=$1 n=$2 conf send min dir tmp out answers lens f note path text sev cf title guarded seen m earlier=""
  local sevre='\[([A-Za-z]+),[[:space:]]*confidence[[:space:]]+([0-9.]+)\]' globs=() g state qs res
  conf=$(cfg)
  send=$(jq -r '.send' <<<"$conf")
  if [ "$(jq -r '.triage' <<<"$conf")" = false ]; then send=off; fi
  case $send in metadata | summary) ;; *) echo "triage round $n: off"; return ;; esac
  min=$(jq -r '.min_confidence' <<<"$conf")
  dir=$job/round-$n
  mkdir -p "$dir" || { echo "triage round $n: off"; return; }

  while IFS= read -r g; do [ -n "$g" ] && globs+=("$g"); done <"$factory/jev/park-paths.txt"
  while IFS= read -r g; do [ -n "$g" ] && globs+=("$g"); done < <(jq -r '.park_paths[]? | strings' <<<"$conf")

  # The paths earlier rounds' Notes named, one per line.
  for ((m = 1; m < n; m++)); do
    for lens in security code ux ui adversarial; do
      while IFS= read -r note; do
        [ -n "$note" ] && earlier="$earlier$(path_of "$note")
"
      done < <(notes_of "$job/round-$m/review-$lens.md")
    done
  done

  tmp=$(mktemp -d "${TMPDIR:-/tmp}/jev-decide.XXXXXX") || { echo "triage round $n: off"; return; }
  : >"$tmp/items"
  local count=0
  for lens in security code ux ui adversarial; do
    f=$dir/review-$lens.md
    [ -f "$f" ] || continue
    while IFS= read -r text; do
      [ -n "$text" ] || continue
      count=$((count + 1))
      path=$(path_of "$text")
      sev='' cf=''
      if [[ $text =~ $sevre ]]; then sev=${BASH_REMATCH[1]} cf=${BASH_REMATCH[2]}; fi
      if [ "$lens" = adversarial ] && [ -n "$sev" ]; then
        title=${text#*\] }; title=${title%%. *}; title=${title%.}
      else
        title=${text%%. *}; title=${title%.}; title=${title:0:80}
      fi
      guarded=false
      if [ "$lens" = security ]; then guarded=true; fi
      while IFS= read -r tok; do
        [ -n "$tok" ] && parked "$tok" ${globs[@]+"${globs[@]}"} && guarded=true
      done < <(paths_of "$text")
      seen=false
      if [ -n "$path" ]; then case "
$earlier" in *"
$path
"*) seen=true ;; esac; fi
      jq -nc --argjson n "$count" --arg lens "$lens" --arg path "$path" --arg title "$title" --arg text "$text" \
        --arg sev "$sev" --arg cf "$cf" --argjson guarded "$guarded" --argjson seen "$seen" \
        '{n: $n, lens: $lens, path: (if $path == "" then null else $path end), title: $title, text: $text,
          severity: (if $sev == "" then null else $sev end), confidence: (if $cf == "" then null else $cf end),
          guarded: $guarded, seen: $seen}' >>"$tmp/items"
    done < <(notes_of "$f")
  done
  local items
  items=$(jq -sc . "$tmp/items")

  state=$(triage_state "$items" "$send")
  answers=null
  local outline
  if [ -z "$state" ]; then
    res=$(triage_sort "$items" '{}' "$send" "$min")
    log_line "$job" "$(make_line triage "round-$n" "$n" "$send" "" "$(jq -c .outcome <<<"$res")")"
  else
    printf '%s\n' "$state" >"$tmp/state"
    qs=$(triage_questions "$send" "$(grep -c '^Note ' "$tmp/state")")
    printf '%s\n' "$qs" >"$tmp/questions"
    if out=$(try_ask triage "$tmp/questions" "$tmp/state"); then
      answers=$(jq -c '.answers // {}' <<<"$out")
      res=$(triage_sort "$items" "$answers" "$send" "$min")
      log_line "$job" "$(make_line triage "round-$n" "$n" "$send" "$out" "$(jq -c .outcome <<<"$res")")"
    else
      res=$(triage_sort "$items" null "$send" "$min")
      log_error "$job" triage "round-$n" "$n" "$send" "$(jq -c .outcome <<<"$res")"
    fi
  fi
  rm -rf "$tmp"

  res=$(jq -c .result <<<"$res")
  jq . <<<"$res" >"$dir/triage.json"
  triage_md "$res" >"$dir/triage.md"
  outline=$(jq -r '"\(.fix_now | length) fix-now, \(.follow_up | length) follow-up, \(.fine | length) fine, \(.approver | length) for the approver"' <<<"$res")
  echo "triage round $n: $outline"
}

# is_ui <path>: true for a UI file: a UI extension, or a UI directory in the path.
is_ui() {
  case $1 in
    *.html | *.css | *.scss | *.sass | *.less | *.tsx | *.jsx | *.vue | *.svelte | *.astro | *.erb | *.hbs | *.swift | *.xib | *.storyboard) return 0 ;;
    *components/* | *pages/* | *views/* | *templates/* | *public/*) return 0 ;;
  esac
  return 1
}

# plural <n> <word>: "1 word", "2 words".
plural() { if [ "$1" = 1 ]; then echo "$1 $2"; else echo "$1 $2s"; fi; }

# review_line <job> <round> <lens> <fix-files>: the state line for a security or
# code review: the lens's verdict in that round, its Findings and Notes counts,
# and the files the round's fix tasks changed.
review_line() {
  local f=$1/round-$2/review-$3.md verdict findings notes
  if [ ! -f "$f" ]; then echo "$3: no review file from round $2"; return; fi
  verdict=$(sed -n '1s/^VERDICT:[[:space:]]*//p' "$f" | tr -d '[:space:]')
  findings=$(sed -n '/^## Findings/,/^## /p' "$f" | grep -cE '^[[:space:]]*[0-9]+\.' || true)
  notes=$(notes_of "$f" | grep -c . || true)
  printf '%s: previous round %s, %s, %s; fix tasks changed %s\n' "$3" "${verdict:-unknown}" \
    "$(plural "$findings" finding)" "$(plural "$notes" note)" "${4:-no files}"
}

# fix_files <job> <round>: the files the "Fix round <round> ..." tasks changed.
fix_files() {
  local id out=""
  while IFS= read -r id; do
    [ -n "$id" ] || continue
    while IFS= read -r f; do
      [ -n "$f" ] && case ", $out," in *", $f,"*) ;; *) out="$out${out:+, }$f" ;; esac
    done < <(commit_files "$1/build/$id.md" 2>/dev/null)
  done < <(jq -r --arg p "Fix round $2 " '.tasks[]? | select((.title // "") | startswith($p)) | .id' "$1/job.json" 2>/dev/null)
  printf '%s' "$out"
}

# reviewers_state <job> <round> <run-index> <asked-lenses>: the state text.
reviewers_state() {
  local job=$1 n=$2 r=$3 asked=$4 wt base stat total=0 shown=0 lines path uis="" nui=0 lens ufiles
  wt=$(jq -r '.worktree // empty' "$job/job.json")
  base=$("$factory/bin/settings" base 2>/dev/null)
  stat=$(git -C "$wt" diff --numstat --no-renames "${base:-main}...HEAD" 2>/dev/null |
    awk -F'\t' '{ l = ($1 == "-" ? 0 : $1) + ($2 == "-" ? 0 : $2); print l "\t" $3 }' | sort -t"$(printf '\t')" -k1,1nr -k2,2)
  printf 'Review round %s (run round %s)\n' "$n" "$r"
  total=$(grep -c . <<<"$stat" || true)
  printf 'Changed files: %s\n' "$total"
  while IFS=$'\t' read -r lines path; do
    [ -n "$path" ] || continue
    if [ "$shown" -lt 40 ]; then printf -- '- %s (%s lines)\n' "$path" "$lines"; shown=$((shown + 1)); fi
    if is_ui "$path"; then
      nui=$((nui + 1))
      [ "$nui" -le 10 ] && uis="$uis${uis:+, }$path"
    fi
  done <<<"$stat"
  [ "$total" -gt 40 ] && printf 'and %s more\n' "$((total - 40))"
  if [ "$nui" -gt 10 ]; then uis="$uis, and $((nui - 10)) more"; fi
  if [ "$nui" = 0 ]; then ufiles="no UI files"; else ufiles="$(plural "$nui" 'UI file') ($uis)"; fi
  for lens in $asked; do
    case $lens in
      ux | ui) printf '%s: %s\n' "$lens" "$ufiles" ;;
      *) review_line "$job" "$((n - 1))" "$lens" "$(fix_files "$job" "$((n - 1))")" ;;
    esac
  done
}

cmd_reviewers() {
  local job=$1 n=$2 conf send min dir r lens f asked="" tmp out round_base key p choice
  local skips="" runs="" outcome='{}' qs why did used ok line
  conf=$(cfg)
  send=$(jq -r '.send' <<<"$conf")
  if [ "$(jq -r '.reviewers' <<<"$conf")" = false ]; then send=off; fi
  case $send in metadata | summary) ;; *) echo "reviewers round $n: run all"; return ;; esac
  min=$(jq -r '.min_confidence' <<<"$conf")
  dir=$job/round-$n
  mkdir -p "$dir" || { echo "reviewers round $n: run all"; return; }
  round_base=$(jq -r '.round_base // 0' "$job/job.json" 2>/dev/null) || round_base=0
  r=$((n - ${round_base:-0}))

  for lens in ux ui security code; do
    f=$dir/review-$lens.md
    if [ -f "$f" ]; then continue; fi
    if [ "$r" -ge 2 ] || [ "$lens" = ux ] || [ "$lens" = ui ]; then asked="$asked${asked:+ }$lens"; fi
  done

  local answers='{}' failed=0
  if [ -n "$asked" ]; then
    tmp=$(mktemp -d "${TMPDIR:-/tmp}/jev-decide.XXXXXX") || { echo "reviewers round $n: run all"; return; }
    reviewers_state "$job" "$n" "$r" "$asked" >"$tmp/state" 2>/dev/null
    qs=$(jq -c --arg a "$asked" '. as $all | ($a | split(" ")) | map({key: "review.\(.)", value: $all["review.\(.)"]}) | from_entries' "$factory/jev/reviewers.json")
    printf '%s\n' "$qs" >"$tmp/questions"
    if out=$(try_ask reviewers "$tmp/questions" "$tmp/state"); then
      answers=$(jq -c '.answers // {}' <<<"$out")
    else
      failed=1
    fi
    for lens in $asked; do
      key=review.$lens
      choice=$(jq -r --arg k "$key" '.[$k].choice // empty' <<<"$answers")
      p=$(jq -r --arg k "$key" '.[$k].p // empty' <<<"$answers")
      case $choice in run | skip) ok=1 ;; *) ok=0 ;; esac
      if [ "$failed" = 1 ] || [ "$ok" = 0 ] || [ -z "$p" ]; then
        used=false why='"error"' did=run
      elif awk -v p="$p" -v m="$min" 'BEGIN { exit !(p < m) }'; then
        used=false why='"low-confidence"' did=run
      else
        used=true why=null did=$choice
      fi
      outcome=$(jq -c --arg k "$key" --argjson u "$used" --argjson w "$why" --arg d "$did" \
        '. + {($k): {used: $u, why: $w, did: $d}}' <<<"$outcome")
      if [ "$did" = skip ]; then
        line=$(grep "^$lens: " "$tmp/state" | head -n 1)
        printf 'VERDICT: SKIPPED\n\nSkipped by Jev (p=%s): %s.\n' "$p" "${line%.}" >"$dir/review-$lens.md"
      fi
    done
    if [ "$failed" = 1 ]; then
      log_error "$job" reviewers "round-$n" "$n" "$send" "$outcome"
    else
      log_line "$job" "$(make_line reviewers "round-$n" "$n" "$send" "$out" "$outcome")"
    fi
    rm -rf "$tmp"
  fi

  # What happens now: a SKIPPED file (new, or kept from before) is a skip.
  for lens in ux ui security code; do
    f=$dir/review-$lens.md
    if [ "$(sed -n 1p "$f" 2>/dev/null)" = "VERDICT: SKIPPED" ]; then
      p=$(sed -n '3s/^Skipped by Jev (p=\([^)]*\)).*/\1/p' "$f")
      skips="$skips${skips:+, }$lens (p=${p:-?})"
    else
      runs="$runs${runs:+, }$lens"
    fi
  done
  runs="$runs${runs:+, }adversarial"
  if [ -z "$skips" ]; then echo "reviewers round $n: run all"; else echo "reviewers round $n: run $runs; skip $skips"; fi
}

main() {
  local sub=${1:-}
  case $sub in
    route)
      if [ $# -lt 3 ]; then
        echo "usage: jev-decide route <job-folder> <task-id>" >&2
        echo "builder (off)"
        return 0
      fi
      if [ ! -f "$2/job.json" ]; then echo "jev-decide: no $2/job.json" >&2; echo "builder (fallback error)"; return 0; fi
      cmd_route "$2" "$3"
      ;;
    triage)
      if [ $# -lt 3 ]; then
        echo "usage: jev-decide triage <job-folder> <round>" >&2
        echo "triage round ${3:-?}: off"
        return 0
      fi
      if [ ! -d "$2" ] || ! [[ $3 =~ ^[0-9]+$ ]]; then echo "jev-decide: bad job folder or round" >&2; echo "triage round $3: off"; return 0; fi
      cmd_triage "$2" "$3"
      ;;
    reviewers)
      if [ $# -lt 3 ]; then
        echo "usage: jev-decide reviewers <job-folder> <round>" >&2
        echo "reviewers round ${3:-?}: run all"
        return 0
      fi
      if [ ! -f "$2/job.json" ] || ! [[ $3 =~ ^[0-9]+$ ]]; then echo "jev-decide: bad job folder or round" >&2; echo "reviewers round $3: run all"; return 0; fi
      cmd_reviewers "$2" "$3"
      ;;
    *) echo "usage: jev-decide route|triage|reviewers ..." >&2 ;;
  esac
  return 0
}

main "$@"
exit 0
