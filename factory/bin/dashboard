#!/usr/bin/env node
// Serves the factory dashboard on this machine only.
//
//   factory/bin/dashboard [--port <n>]       default port 4100
//
// Open http://127.0.0.1:<port>/. The page polls GET /api/state (models,
// land mode and every job with its usage and past review verdicts), gets
// agent runs through GET /api/runs?job=<id>, task changes through
// GET /api/changes?job=<id> and GET /api/diff?job=<id>[&task=<id>|&commit=<hex>],
// and job files through GET /api/files?job=<id> and
// GET /api/file?job=<id>&path=<path>. Everything is read-only. Only .md files,
// plan.json and usage.jsonl inside
// factory/jobs/<id>/ are listed; /api/file also serves .runs/<stem>.prompt.md
// and .runs/<stem>.last.md, while raw Codex logs stay private. Listens on
// 127.0.0.1 only.
// Exit: 1 if the port is taken, 2 usage.
'use strict'
const http = require('http')
const fs = require('fs')
const path = require('path')
const { STEM, listRuns, derivedUsage } = require('../dashboard/runs')
const dashboardGit = require('../dashboard/git')

const factory = path.resolve(__dirname, '..')
const jobsDir = path.join(factory, 'jobs')
const REVIEWERS = ['security', 'code', 'ux', 'ui', 'adversarial']

const args = process.argv.slice(2)
let port = 4100
if (args.length === 2 && args[0] === '--port' && /^\d+$/.test(args[1])) port = Number(args[1])
else if (args.length) {
  console.error('usage: dashboard [--port <n>]')
  process.exit(2)
}

const read = (p) => fs.readFileSync(p, 'utf8')
const firstLine = (text) => text.split('\n')[0].trim()

function readJSON(p, fallback) {
  try { return JSON.parse(read(p)) } catch { return fallback }
}

// usage.jsonl: one JSON object per line; lines that don't parse are skipped.
function readUsage(dir) {
  let text
  try { text = read(path.join(dir, 'usage.jsonl')) } catch { return [] }
  const out = []
  for (const line of text.split('\n')) {
    if (!line.trim()) continue
    try {
      const r = JSON.parse(line)
      if (r && typeof r === 'object' && !Array.isArray(r)) out.push(r)
    } catch { /* skip */ }
  }
  return out
}

// Earlier rounds aren't in job.json; their verdicts come from the review files.
function pastRounds(dir, round) {
  const rounds = []
  for (let n = 1; n < (Number(round) || 0); n++) {
    const v = {}
    for (const k of REVIEWERS) {
      try {
        const m = firstLine(read(path.join(dir, `round-${n}`, `review-${k}.md`))).match(/^VERDICT:\s*(PASS|CHANGES)$/)
        v[k] = m ? m[1] : 'invalid'
      } catch {
        v[k] = 'missing'
      }
    }
    rounds.push(v)
  }
  return rounds
}

function state() {
  const problems = []
  let ids = []
  try {
    ids = fs.readdirSync(jobsDir, { withFileTypes: true })
      .filter((d) => d.isDirectory() && !d.name.startsWith('.')).map((d) => d.name).sort()
  } catch { /* no jobs folder yet */ }
  const jobs = []
  for (const id of ids) {
    const dir = path.join(jobsDir, id)
    if (!fs.existsSync(path.join(dir, 'job.json'))) continue
    const job = readJSON(path.join(dir, 'job.json'), null)
    if (!job || typeof job !== 'object') { problems.push(`jobs/${id}/job.json is not valid JSON`); continue }
    const hasUsage = fs.existsSync(path.join(dir, 'usage.jsonl'))
    const item = {
      ...job,
      id: job.id || id,
      usage: hasUsage ? readUsage(dir) : derivedUsage(dir, job),
      past: pastRounds(dir, job.round),
    }
    if (!hasUsage) item.usage_derived = true
    jobs.push(item)
  }
  const settings = readJSON(path.join(factory, 'settings.json'), {})
  return {
    land: settings && settings.land === 'local' ? 'local' : 'pr',
    models: readJSON(path.join(factory, 'models.json'), {}),
    jobs,
    problems,
  }
}

// The job's folder, or null for anything that isn't a plain job id.
function jobDir(id) {
  if (!id || !/^[A-Za-z0-9][A-Za-z0-9._-]*$/.test(id)) return null
  const dir = path.join(jobsDir, id)
  return fs.existsSync(path.join(dir, 'job.json')) ? dir : null
}

const servable = (rel) => {
  const runFile = rel.match(/^\.runs\/(.+)\.(prompt|last)\.md$/)
  if (runFile) return STEM.test(runFile[1])
  return !rel.split('/').some((s) => s.startsWith('.')) &&
    (rel.endsWith('.md') || rel === 'plan.json' || rel === 'usage.jsonl')
}

function listFiles(dir, prefix = '') {
  const out = []
  for (const d of fs.readdirSync(path.join(dir, prefix), { withFileTypes: true })) {
    if (d.name.startsWith('.')) continue
    const rel = prefix ? `${prefix}/${d.name}` : d.name
    if (d.isDirectory()) out.push(...listFiles(dir, rel))
    else if (d.isFile() && servable(rel)) out.push(rel)
  }
  return out
}

// The first line the drawer colours a file by: plan.json's is its status.
function headline(dir, rel) {
  const text = read(path.join(dir, rel))
  if (rel === 'plan.json') {
    const plan = readJSON(path.join(dir, rel), null)
    return plan ? `STATUS: ${plan.status}` : 'STATUS: BLOCKED'
  }
  return rel === 'usage.jsonl' ? '' : firstLine(text)
}

function send(res, code, type, body) {
  res.writeHead(code, { 'content-type': type, 'cache-control': 'no-store', 'x-content-type-options': 'nosniff' })
  res.end(body)
}
const json = (res, code, body) => send(res, code, 'application/json; charset=utf-8', JSON.stringify(body))

const server = http.createServer(async (req, res) => {
  if (req.method !== 'GET') return json(res, 405, { error: 'read-only' })
  const url = new URL(req.url, 'http://localhost')
  try {
    if (url.pathname === '/' || url.pathname === '/dashboard.html') {
      return send(res, 200, 'text/html; charset=utf-8', read(path.join(factory, 'dashboard.html')))
    }
    if (url.pathname === '/api/state') return json(res, 200, state())
    if (url.pathname === '/api/runs') {
      const id = url.searchParams.get('job')
      const dir = jobDir(id)
      if (!dir) return json(res, 404, { error: 'no such job' })
      const job = readJSON(path.join(dir, 'job.json'), {})
      return json(res, 200, listRuns(dir, job, readUsage(dir)))
    }
    if (url.pathname === '/api/changes' || url.pathname === '/api/diff') {
      const id = url.searchParams.get('job')
      const dir = jobDir(id)
      if (!dir) return json(res, 404, { error: 'no such job' })
      const job = readJSON(path.join(dir, 'job.json'), {})
      const settings = readJSON(path.join(factory, 'settings.json'), {})
      const gitJob = {
        ...job,
        _dashboardBase: settings && settings.land === 'local' ? 'main' : 'origin/main',
      }
      const repo = path.resolve(factory, '..')
      if (url.pathname === '/api/changes') {
        return json(res, 200, await dashboardGit.changes(repo, id, gitJob))
      }
      const result = await dashboardGit.diff(repo, id, gitJob, {
        task: url.searchParams.has('task') ? url.searchParams.get('task') : undefined,
        commit: url.searchParams.has('commit') ? url.searchParams.get('commit') : undefined,
      })
      if (result.status !== 200) return json(res, result.status, { error: result.text })
      const headers = {
        'content-type': 'text/plain; charset=utf-8',
        'cache-control': 'no-store',
        'x-content-type-options': 'nosniff',
      }
      if (result.truncated) headers['x-diff-truncated'] = '1'
      res.writeHead(200, headers)
      return res.end(result.text)
    }
    if (url.pathname === '/api/files' || url.pathname === '/api/file') {
      const dir = jobDir(url.searchParams.get('job'))
      if (!dir) return json(res, 404, { error: 'no such job' })
      if (url.pathname === '/api/files') {
        return json(res, 200, listFiles(dir).map((p) => ({ path: p, first: headline(dir, p) })))
      }
      const rel = url.searchParams.get('path') || ''
      const full = path.resolve(dir, rel)
      // realpath too, so a symlink can't lead out of the job folder.
      if (!servable(rel) || !fs.existsSync(full) ||
          !fs.realpathSync(full).startsWith(fs.realpathSync(dir) + path.sep)) {
        return json(res, 404, { error: 'no such file' })
      }
      return send(res, 200, 'text/plain; charset=utf-8', read(full))
    }
    json(res, 404, { error: 'not found' })
  } catch (err) {
    json(res, 500, { error: err.message })
  }
})

server.on('error', (err) => {
  console.error(err.code === 'EADDRINUSE' ? `dashboard: port ${port} is in use; pass --port <n>` : `dashboard: ${err.message}`)
  process.exit(1)
})
server.listen(port, '127.0.0.1', () => console.log(`dashboard: http://127.0.0.1:${port}/`))
