#!/usr/bin/env bash
# Builds and records the prompt for a Claude role.
#
#   factory/bin/prompt-record <job-folder> <key> <prompt>
#
# Builds the prompt with factory/bin/role-prompt (the shared role preamble, the
# role, then <prompt>), writes it to
# <job-folder>/.runs/<timestamp>-<key>.prompt.md, named as run-codex names its
# prompts, and prints it: the orchestrator sends that output, verbatim, as the
# factory-agent prompt. Exit codes: 2 for usage, unknown keys or missing role
# files; 1 if it cannot write.
set -uo pipefail

if [ $# -ne 3 ]; then
  echo "usage: prompt-record <job-folder> <key> <prompt>" >&2
  exit 2
fi
job=$1 key=$2 prompt=$3
factory=$(cd "$(dirname "$0")/.." && pwd)

text=$("$factory/bin/role-prompt" "$key" "$prompt") || exit 2
mkdir -p "$job/.runs" || { echo "prompt-record: could not create $job/.runs" >&2; exit 1; }
log="$job/.runs/$(date +%Y%m%d-%H%M%S)-$key.prompt.md"
printf '%s\n' "$text" >"$log" || {
  echo "prompt-record: could not write $log" >&2
  exit 1
}
printf '%s\n' "$text"
